# ============================================================================
# Configuração do Estuda.AI
# Copie este arquivo para .env (cp .env.example .env) e preencha a sua chave.
# O arquivo .env é pessoal e NUNCA deve ir para o Git.
# Depois de mudar qualquer valor, rode: docker compose up -d
# (o container só lê o .env quando é criado)
# ============================================================================


# ---------------------------------------------------------------------------
# Ollama Cloud (modelo de chat)
# ---------------------------------------------------------------------------

# OLLAMA_API_KEY
# O que é: sua chave de acesso ao Ollama Cloud (ollama.com > Settings > API keys).
# Por que: é assim que a nuvem sabe quem você é; o app envia a chave em cada chamada
#   de chat/quiz/resposta. Cada aluno usa a sua própria chave.
# Atenção: copie a chave INTEIRA (ela tem duas partes separadas por um ponto).
#   Chave cortada ou ausente dá erro 401 "Chave inválida".
OLLAMA_API_KEY=cole-sua-chave-aqui

# CHAT_MODEL
# O que é: o modelo de linguagem da nuvem que conversa, gera o quiz e redige as respostas.
# Por que: modelo e chave são separados para você poder trocar de modelo e comparar a
#   qualidade sem mexer no código. O padrão (gpt-oss:20b) é o menor e mais rápido, o que
#   deixa mais folga no limite da conta gratuita.
# Opções na conta free: gpt-oss:20b | gpt-oss:120b | gemma4:31b
#   | nemotron-3-nano:30b | nemotron-3-super | nemotron-3-ultra
CHAT_MODEL=gpt-oss:20b

# OLLAMA_CLOUD_URL
# O que é: endereço base da API na nuvem.
# Por que: fica em variável para a oficina não ter o endereço "chumbado" no código.
#   Só mude se o provedor mudar o endereço.
OLLAMA_CLOUD_URL=https://ollama.com


# ---------------------------------------------------------------------------
# Ollama local (embeddings e reranking, usados no RAG da etapa 3)
# ---------------------------------------------------------------------------

# EMBED_MODEL
# O que é: modelo local que transforma textos em vetores (embeddings).
# Por que: o RAG compara o SIGNIFICADO da pergunta com o dos trechos da apostila.
#   Roda local para não gastar a cota da nuvem na indexação e funcionar sem internet
#   depois do download. Ele produz vetores de 768 dimensões, que é o tamanho da coluna
#   "embedding" em db/init.sql: se trocar de modelo, ajuste as duas coisas.
EMBED_MODEL=embeddinggemma:300m

# RERANK_MODEL
# O que é: modelo local que relê os trechos encontrados e dá uma nota de 0 a 1 de quanto
#   cada um responde à pergunta.
# Por que: a busca vetorial acha trechos "parecidos"; o reranker põe na frente os que
#   realmente respondem. Usamos a variante F16 porque a Q8_0 gerou saída sem sentido nos
#   testes em Docker/Linux arm64. Se a sua máquina rodar bem a Q8_0 (menor, 639 MB),
#   pode trocar por dengcao/Qwen3-Reranker-0.6B:Q8_0.
RERANK_MODEL=dengcao/Qwen3-Reranker-0.6B:F16

# RERANK_ENABLED
# O que é: liga (true) ou desliga (false) o reranking.
# Por que: o reranker é uma etapa opcional e ocupa memória. Se a máquina estiver lenta
#   ou o modelo falhar, coloque false: o RAG continua funcionando só com a busca vetorial.
RERANK_ENABLED=true

# OLLAMA_LOCAL_URL
# O que é: endereço do Ollama local dentro da rede do Docker Compose.
# Por que: "ollama" é o nome do serviço no docker-compose.yml. Não mude, a menos que
#   rode o Ollama fora do Compose.
OLLAMA_LOCAL_URL=http://ollama:11434


# ---------------------------------------------------------------------------
# Banco de dados (pgvector)
# ---------------------------------------------------------------------------

# DATABASE_URL
# O que é: conexão com o PostgreSQL com a extensão pgvector, que guarda os vetores.
# Por que: o RAG precisa persistir os trechos indexados e buscar por similaridade em SQL.
#   Usuário, senha e banco devem bater com o serviço "pgvector" do docker-compose.yml.
#   A senha é só para este ambiente local; não reutilize em produção.
DATABASE_URL=postgresql://postgres:oficina@pgvector:5432/oficina


# ---------------------------------------------------------------------------
# Comportamento do app
# ---------------------------------------------------------------------------

# QUIZ_MAX_RETRIES
# O que é: quantas vezes o app pede ao modelo para corrigir um JSON de quiz inválido.
# Por que: LLMs às vezes erram o formato. O app valida a resposta e tenta de novo.
#   Com 2, há no máximo 3 chamadas por quiz (a conta free aceita 1 requisição por vez,
#   então mais tentativas deixam a espera longa).
QUIZ_MAX_RETRIES=2

# RAG_TOP_K
# O que é: quantos trechos da apostila a busca devolve por pergunta.
# Por que: poucos trechos podem perder a resposta; muitos aumentam o custo e o ruído
#   no prompt. Com um corpus pequeno, 4 funciona bem.
RAG_TOP_K=4

# SIM_MIN
# O que é: similaridade mínima (de 0 a 1) para um trecho ser considerado relevante.
# Por que: evita que o modelo responda com trechos que não têm a ver com a pergunta.
#   Se nenhum trecho passar, o app responde "Não encontrei isso no material" sem
#   chamar o modelo. Medido neste corpus: trechos certos ficam entre 0,40 e 0,76 e
#   perguntas fora do assunto, no máximo 0,24. Se o app recusar perguntas legítimas,
#   baixe o valor; se aceitar assuntos que não estão na apostila, aumente.
SIM_MIN=0.3
